{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/lib/mock-data": ["./lib/mock-data.ts"],
      "@/lib/use-persistent-collection": ["./lib/use-persistent-collection.ts"],
      "@/lib/preferences": ["./lib/preferences.ts"],
      "@/components/shell": ["./components/shell.ts"],
      "@/components/record-dialog": ["./components/record-dialog.tsx"],
      "@/components/theme-provider": ["./components/theme-provider.tsx"],
      "@/components/ui": ["./components/ui/index.ts"],
      "@/constants/homepage": ["./lib/homepage-constants.ts"],
      "@/constants/*": ["./lib/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "src"]
}
