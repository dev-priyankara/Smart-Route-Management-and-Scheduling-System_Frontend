{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/components/ui": ["./src/components/ui/index.ts"],
      "@/components/ui/*": ["./src/components/ui/*"],
      "@/components/shared": ["./src/components/shared/index.ts"],
      "@/components/shared/*": ["./src/components/shared/*"],
      "@/components/theme-provider": ["./src/components/shared/ThemeProvider.tsx"],
      "@/components/shell": ["./src/components/shared/shell.ts"],
      "@/components/record-dialog": ["./src/components/shared/RecordDialog.tsx"],
      "@/lib/mock-data": ["./src/lib/mock-data.ts"],
      "@/lib/use-persistent-collection": ["./src/lib/use-persistent-collection.ts"],
      "@/lib/preferences": ["./src/lib/preferences.ts"],
      "@/constants/homepage": ["./src/constants/homepage.ts"],
      "@/constants/*": ["./src/constants/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
